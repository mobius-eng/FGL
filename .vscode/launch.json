    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run JsonTest (C)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/JsonTest/json_test",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/JsonTest",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
